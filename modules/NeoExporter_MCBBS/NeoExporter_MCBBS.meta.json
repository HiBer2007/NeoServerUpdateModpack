{
  "name": "MCBBS Modpack Exporter",
  "version": "1.0.0",
  "dll": "NeoExporter_MCBBS.dll",
  "format": "mcbbs",
  "extension": ".zip",
  "description": "MCBBS / PCL / HMCL 通用整合包格式",
  "fields": [
    { "key": "name", "label": "整合包名称", "required": true, "group": "基本信息", "placeholder": "例如: 我的整合包" },
    { "key": "version", "label": "版本号", "required": true, "group": "基本信息", "placeholder": "例如: 1.0.0" },
    { "key": "author", "label": "作者", "required": false, "group": "基本信息", "placeholder": "作者名称" },
    { "key": "description", "label": "整合包描述", "required": false, "group": "可选信息", "type": "multiline", "placeholder": "整合包描述 (可选)" }
  ]
}
