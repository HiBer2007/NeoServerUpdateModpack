{
  "id": "uninstall",
  "steps": [
    { "id": "confirm", "ui": "confirm", "prompt": "移除 NSUM 全部文件？", "abortIfNo": true },
    { "id": "registry", "type": "registry", "key": "Software/HiBer2007/NSUM",
      "action": "delete" },
    { "id": "clean", "type": "clean", "target": "{installDir}" },
    { "id": "finish", "ui": "finish", "message": "NSUM 已卸载" }
  ]
}