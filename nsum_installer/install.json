{
  "id": "install",
  "steps": [
    { "id": "welcome", "ui": "welcome" },
    { "id": "license", "ui": "license", "source": "qrc:/LICENSE.txt" },
    { "id": "path", "ui": "path" },
    { "id": "components", "ui": "components" },
    { "id": "gitPlan", "type": "nsum_git_plan", "editorVariant": "PortableGit",
      "when": "vars.gitPlanned ~= 'true'" },
    { "id": "gitDownload", "type": "download", "asset": "git-for-windows/git",
      "variant": "{gitVariant}", "dest": "{tempDir}/neo_git.zip",
      "when": "vars.gitDownload == 'true'" },
    { "id": "gitExtract", "type": "extract", "source": "zip:{tempDir}/neo_git.zip",
      "target": "{installDir}/tools/git", "when": "vars.gitDownload == 'true'" },
    { "id": "cleanTarget", "type": "clean", "target": "{installDir}" },
    { "id": "extract", "type": "extract", "source": "qrc:/deploy", "target": "{installDir}" },
    { "id": "writeconf", "type": "template", "target": "{installDir}",
      "file": "install.conf",
      "header": "# NeoServer Install Configuration",
      "template": {
        "install_path": "{installDir}",
        "install_editor": "{components.editor}",
        "use_system_git": "{gitUseSystem}",
        "git_path": "{installDir}/tools/git/bin/git.exe"
      } },
    { "id": "shortcutA", "type": "shortcut", "kind": "desktop", "name": "NeoServer.lnk",
      "target": "{installDir}/NeoServerUpdateModpack.exe",
      "workDir": "{installDir}" },
    { "id": "shortcutB", "type": "shortcut", "kind": "startmenu",
      "name": "NeoServer/NeoServer.lnk",
      "target": "{installDir}/NeoServerUpdateModpack.exe",
      "workDir": "{installDir}" },
    { "id": "shortcutEditor", "type": "shortcut", "kind": "desktop",
      "name": "NeoWorkspaceEditor.lnk",
      "target": "{installDir}/NeoWorkspaceEditor.exe",
      "workDir": "{installDir}",
      "when": "vars['components.editor'] == 'true'" },
    { "id": "finish", "ui": "finish", "message": "NeoServer 安装完成",
      "launch": "NeoServerUpdateModpack.exe" }
  ]
}