{
  "id": "install",
  "steps": [
    { "id": "lang", "ui": "language", "default": "zh" },
    { "id": "welcome", "ui": "welcome" },
    { "id": "license", "ui": "license", "source": "qrc:/LICENSE.txt" },
    { "id": "path", "ui": "path" },
    { "id": "components", "ui": "components" },
    { "id": "gitChoice", "ui": "git", "installSystemOption": true },
    { "id": "gitPlan", "type": "git_plan", "editorComponent": "editor",
      "editorVariant": "PortableGit",
      "when": "vars.gitPlanned ~= 'true'" },
    { "id": "gitDownload", "type": "download", "asset": "git-for-windows/git",
      "variant": "{gitVariant}", "dest": "{tempDir}/neo_git.zip",
      "when": "vars.gitDownload == 'true' and vars.gitInstallKind ~= 'system'" },
    { "id": "gitExtract", "type": "extract", "source": "zip:{tempDir}/neo_git.zip",
      "target": "{gitInstallDir}",
      "when": "vars.gitDownload == 'true' and vars.gitInstallKind ~= 'system'" },
    { "id": "gitInstallerDownload", "type": "download", "asset": "git-for-windows/git",
      "variant": "{gitVariant}", "ext": "exe", "dest": "{gitInstallerPath}",
      "when": "vars.gitInstallKind == 'system'" },
    { "id": "gitElevate", "ui": "elevate",
      "reason": "需要管理员权限在系统中安装 Git",
      "when": "vars.gitInstallKind == 'system'" },
    { "id": "gitRunInstaller", "type": "run",
      "program": "{gitInstallerPath}",
      "args": ["/VERYSILENT", "/NORESTART"],
      "when": "vars.gitInstallKind == 'system'" },
    { "id": "gitRefresh", "type": "git_refresh",
      "when": "vars.gitInstallKind == 'system'" },
    { "id": "cleanTarget", "type": "clean", "target": "{installDir}" },
    { "id": "extract", "type": "extract", "source": "qrc:/deploy", "target": "{installDir}" },
    { "id": "writeconf", "type": "template", "target": "{installDir}",
      "file": "install.conf",
      "header": "# NSUM Install Configuration",
      "template": {
        "install_path": "{installDir}",
        "install_editor": "{components.editor}",
        "use_system_git": "{gitUseSystem}",
        "git_path": "{gitPath}"
      } },
    { "id": "shortcutA", "type": "shortcut", "kind": "desktop", "name": "NSUM.lnk",
      "target": "{installDir}/NeoServerUpdateModpack.exe",
      "workDir": "{installDir}" },
    { "id": "shortcutB", "type": "shortcut", "kind": "startmenu",
      "name": "NSUM/NSUM.lnk",
      "target": "{installDir}/NeoServerUpdateModpack.exe",
      "workDir": "{installDir}" },
    { "id": "shortcutEditor", "type": "shortcut", "kind": "desktop",
      "name": "NeoWorkspaceEditor.lnk",
      "target": "{installDir}/NeoWorkspaceEditor.exe",
      "workDir": "{installDir}",
      "when": "vars['components.editor'] == 'true'" },
    { "id": "finish", "ui": "finish", "message": "NSUM 安装完成",
      "launch": "NeoServerUpdateModpack.exe",
      "launchOptions": [
        { "name": "Neo Server Update Modpack", "path": "{installDir}/NeoServerUpdateModpack.exe" },
        { "name": "NeoWorkspaceEditor", "path": "{installDir}/NeoWorkspaceEditor.exe" }
      ] }
  ]
}