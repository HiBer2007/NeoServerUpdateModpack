{
  "productName": "NSUM",
  "company": "HiBer2007",
  "orgName": "HiBer2007",
  "version": "@NSUM_INSTALLER_VERSION@",
  "defaultMode": "gui",
  "defaultLanguage": "zh",
  "backEnabled": true,
  "welcomeTitle": "Neo Server Update Modpack",
  "defaultInstallPath": "%APPDATA%\\NSUM",
  "banner": { "font": "neo" },
  "components": [
    { "id": "core", "label": "NSUM 核心",
      "description": "主程序本体（新 服务器自动更新整合包），必装。",
      "required": true, "defaultChecked": true },
    { "id": "editor", "label": "NeoWorkspaceEditor",
      "description": "整合包内容 IDE：编辑配置、转换指针、Git 面板等。",
      "exe": "NeoWorkspaceEditor.exe",
      "shortcutName": "NeoWorkspaceEditor", "defaultChecked": false }
  ],
  "shortcuts": [
    { "kind": "desktop", "name": "NSUM.lnk", "target": "{installDir}/NeoServerUpdateModpack.exe" },
    { "kind": "startmenu", "name": "NSUM/NSUM.lnk", "target": "{installDir}/NeoServerUpdateModpack.exe" }
  ],
  "installConf": {
    "fileName": "install.conf",
    "header": "# NSUM Install Configuration",
    "template": {
      "install_path": "{installDir}",
      "install_editor": "{components.editor}",
      "use_system_git": "{gitUseSystem}",
      "git_path": "{installDir}/tools/git/bin/git.exe"
    }
  },
  "flows": {
    "install": "install.json",
    "uninstall": "uninstall.json",
    "repair": "repair.json",
    "upgrade": "upgrade.json"
  },
  "payload": { "source": "qrc:/deploy", "skip": ["*.dmp", "config/custom/*"] },
  "uninstall": { "registryKey": "Software/HiBer2007/NSUM", "displayName": "NSUM（新 服务器自动更新整合包）" }
}