{
  "productName": "NeoServer Tools",
  "company": "HiBer2007",
  "orgName": "HiBer2007",
  "version": "1.0.0",
  "defaultMode": "gui",
  "defaultInstallPath": "C:\\Program Files\\NeoServer",
  "banner": { "font": "slant" },
  "components": [
    { "id": "editor", "label": "NeoWorkspaceEditor", "exe": "NeoWorkspaceEditor.exe",
      "shortcutName": "NeoWorkspaceEditor", "defaultChecked": false }
  ],
  "shortcuts": [
    { "kind": "desktop", "name": "NeoServer.lnk", "target": "{installDir}/NeoServerUpdateModpack.exe" },
    { "kind": "startmenu", "name": "NeoServer/NeoServer.lnk", "target": "{installDir}/NeoServerUpdateModpack.exe" }
  ],
  "installConf": {
    "fileName": "install.conf",
    "header": "# NeoServer Install Configuration",
    "template": {
      "install_path": "{installDir}",
      "install_editor": "{components.editor}",
      "use_system_git": "{gitUseSystem}",
      "git_path": "{installDir}/tools/git/bin/git.exe"
    }
  },
  "flows": {
    "install": "install.json",
    "uninstall": "uninstall.json"
  },
  "payload": { "source": "qrc:/deploy", "skip": ["*.dmp", "config/custom/*"] },
  "uninstall": { "registryKey": "Software/HiBer2007/NeoServer", "displayName": "NeoServer 整合包管理工具" }
}