#pragma code_page(65001)

#include <winres.h>

@NSUM_ICON_BLOCK@
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @NSUM_VER_MAJOR@,@NSUM_VER_MINOR@,@NSUM_VER_PATCH@,0
 PRODUCTVERSION @NSUM_VER_MAJOR@,@NSUM_VER_MINOR@,@NSUM_VER_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE @NSUM_FILETYPE@
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "HiBer2007"
            VALUE "FileDescription", "@NSUM_DESC@"
            VALUE "FileVersion", "@NSUM_VERSION@"
            VALUE "InternalName", "@NSUM_INTERNAL@"
            VALUE "LegalCopyright", "Copyright (C) 2026 HiBer2007"
            VALUE "OriginalFilename", "@NSUM_ORIGINAL@"
            VALUE "ProductName", "@NSUM_PRODUCT@"
            VALUE "ProductVersion", "@NSUM_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END